 g7_keys <- function(x, required) is.list(x) && !is.null(names(x)) &&
   !anyDuplicated(names(x)) && all(required %in% names(x))
+g7_date <- function(x, year) {
+  if (!is.character(x) || !g7_scalar(x) ||
+      !grepl("^[0-9]{2}/[0-9]{2}/[0-9]{4}$", x)) return(FALSE)
+  parsed <- as.Date(x, "%d/%m/%Y")
+  !is.na(parsed) && format(parsed, "%d/%m/%Y") == x &&
+    as.integer(format(parsed, "%Y")) == year
+}
+g7_check_utf8 <- function(path) {
+  bytes <- readBin(path, "raw", n = file.info(path)$size)
+  if (any(bytes == as.raw(0))) g7_fail("Invalid UTF-8 CSV: embedded NUL")
+  if (!validUTF8(rawToChar(bytes))) g7_fail("Invalid UTF-8 CSV bytes")
+  invisible(NULL)
+}
 
